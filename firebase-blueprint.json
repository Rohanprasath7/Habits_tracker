{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "settings": {
          "type": "object",
          "properties": {
            "theme": { "type": "string", "enum": ["light", "dark", "system"] },
            "notificationsEnabled": { "type": "boolean" }
          }
        }
      },
      "required": ["uid", "email"]
    },
    "Habit": {
      "title": "Habit",
      "description": "A recurring habit to track",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "frequency": { "type": "string", "enum": ["daily", "weekly"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "currentStreak": { "type": "number", "default": 0 },
        "longestStreak": { "type": "number", "default": 0 }
      },
      "required": ["userId", "name", "frequency"]
    },
    "HabitLog": {
      "title": "HabitLog",
      "description": "Daily completion status of a habit",
      "type": "object",
      "properties": {
        "habitId": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "completed": { "type": "boolean" }
      },
      "required": ["habitId", "userId", "date", "completed"]
    },
    "Task": {
      "title": "Task",
      "description": "A single todo item or schedule",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "dueDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["todo", "in-progress", "done"] },
        "priority": { "type": "string", "enum": ["high", "medium", "low"] },
        "category": { "type": "string", "enum": ["work", "personal", "meeting", "appointment", "health", "leisure"] },
        "reminderAt": { "type": "string", "format": "date-time" },
        "isGoogleCalendarSync": { "type": "boolean" },
        "calendarEventId": { "type": "string" }
      },
      "required": ["userId", "title", "status"]
    },
    "Achievement": {
      "title": "Achievement",
      "description": "A user-wide milestone or milestone related to a habit",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "type": { "type": "string", "enum": ["streak", "goal", "first-time", "habit-master"] },
        "unlockedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "type"]
    },
    "DayPlan": {
      "title": "DayPlan",
      "description": "An optimized daily schedule generated by AI",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["task", "habit", "event", "break"] },
              "title": { "type": "string" },
              "startTime": { "type": "string", "format": "date-time" },
              "endTime": { "type": "string", "format": "date-time" },
              "completed": { "type": "boolean" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "date", "items"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user data"
    },
    "/habits/{habitId}": {
      "schema": "Habit",
      "description": "Global habits list"
    },
    "/habit_logs/{logId}": {
      "schema": "HabitLog",
      "description": "Logs for habit completions"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "User tasks and to-do items"
    },
    "/achievements/{achievementId}": {
      "schema": "Achievement",
      "description": "Global user achievements"
    },
    "/day_plans/{planId}": {
      "schema": "DayPlan",
      "description": "AI generated daily agendas"
    }
  }
}
